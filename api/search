],[69,"컴포넌트는 패키지 root 또는 manifest에 선언된 공개 category 경로에서 import합니다."],[99,"컴포넌트별 크기와 상태 표현의 소스 값."],[9,"컴포넌트에서 공개 경로와 예제를 선택합니다."],[27,"컴포넌트의 정확한 이름과 prop 타입은 설치한 패키지의 타입 선언이 기준입니다. 이 문서는 자주 쓰는 조합을 보여주며, 모든 상태는 Storybook에서 확인할 수 있습니다."],[17,"콘텐츠가 없으면 `EmptyState`, 진행 중이면 `Spinner` 또는 `Skeleton`을 사용합니다. Alert 예제 · Toast 예제"],[116,"타이포그래피와 형태"],[90,"토큰 값을 명령 출력, 이슈 또는 CI 로그에 남기지 마세요."],[49,"토큰 기반 간격과 콘텐츠 배치를 조합합니다."],[85,"토큰 전달 여부와 만료"],[75,"패키지 설치"],[119,"표의 이름과 값은 현재 소스의 `packages/tokens/src/reference/*.json`에서 빌드 시 읽습니다. 색상 칸에는 직접 색상값이 있는 경우 견본을 표시합니다."],[80,"현재 소스 manifest 버전은 아래와 같습니다. **설치 전 registry에 같은 버전이 있는지 확인**하세요. 제품에서 Lotto UI가 필요하지 않으면 마지막 패키지는 생략합니다."]],"type":"string"},"page_id":{"docs":{"1":0,"2":1,"3":2,"4":3,"5":4,"6":5,"7":6,"8":7,"9":8,"10":9,"11":10,"12":35,"13":36,"14":37,"15":38,"16":39,"17":40,"18":41,"19":42,"20":43,"21":44,"22":45,"23":46,"24":11,"25":12,"26":13,"27":14,"28":15,"29":16,"30":17,"31":18,"32":19,"33":20,"34":21,"35":22,"36":23,"37":24,"38":25,"39":26,"40":27,"41":28,"42":29,"43":30,"44":31,"45":32,"46":33,"47":34,"48":47,"49":48,"50":49,"51":50,"52":51,"53":52,"54":53,"55":54,"56":55,"57":56,"58":57,"59":58,"60":59,"61":60,"62":61,"63":62,"64":63,"65":64,"66":65,"67":66,"68":67,"69":68,"70":69,"71":70,"72":71,"73":72,"74":73,"75":74,"76":75,"77":76,"78":77,"79":78,"80":79,"81":80,"82":81,"83":82,"84":83,"85":84,"86":85,"87":86,"88":87,"89":88,"90":89,"91":90,"92":91,"93":92,"94":93,"95":94,"96":95,"97":96,"98":106,"99":107,"100":108,"101":109,"102":97,"103":98,"104":99,"105":100,"106":101,"107":102,"108":103,"109":104,"110":105,"111":110,"112":111,"113":112,"114":113,"115":114,"116":115,"117":116,"118":117,"119":118,"120":119,"121":120,"122":121,"123":122,"124":123,"125":124},"orderedDocs":[[1,"/docs"],[2,"/docs"],[3,"/docs"],[4,"/docs"],[5,"/docs"],[6,"/docs"],[7,"/docs"],[8,"/docs"],[9,"/docs"],[10,"/docs"],[11,"/docs"],[24,"/docs/components"],[25,"/docs/components"],[26,"/docs/components"],[27,"/docs/components"],[28,"/docs/